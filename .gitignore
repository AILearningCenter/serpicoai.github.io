# Local-only working area (Anchor worktrees/caches, parked deploy
# artifacts such as var/github-workflows/) — never commit
var/

# Astro build output / generated types
dist/
.astro/

# Node dependencies
node_modules/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# JetBrains setting folder
.idea/

# Python bytecode cache (Anchor fleet scripts)
__pycache__/
*.pyc
