---
import { primaryNav, brandName } from "../nav.config";
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__brand" href="/">
      <img class="site-header__logo" src="/assets/logos/header-logo.svg" alt="" aria-hidden="true" width="56" height="56" />
      <span class="site-header__brand-name">{brandName}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">
      ☰
    </label>

    <nav class="site-nav" aria-label="Primary">
      {primaryNav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
