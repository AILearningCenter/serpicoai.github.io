---
import { footerNav, brandName, socialLinks } from "../nav.config";

const year = new Date().getFullYear();
const columns = Object.values(footerNav);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__columns">
      {columns.map((column) => (
        <div>
          <p class="site-footer__heading">{column.heading}</p>
          <ul class="site-footer__list">
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} {brandName}. All rights reserved.</p>
      <ul class="site-footer__social" aria-label="Social links">
        {socialLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noreferrer noopener" aria-label={link.label}>
              <img src={link.icon} alt="" aria-hidden="true" width="24" height="24" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
