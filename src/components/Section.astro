---
interface Props {
  title?: string;
  image?: string;
  imageAlt?: string;
  alt?: boolean;
}

const { title, image, imageAlt, alt } = Astro.props as Props;
---

<section class={alt ? "section section--alt" : "section"} data-reveal>
  <div class="container">
    {image && <img class="section__image" src={image} alt={imageAlt ?? ""} loading="lazy" />}
    {title && <h2 class="section__title">{title}</h2>}
    <slot />
  </div>
</section>
