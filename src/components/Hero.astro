---
interface Props {
  heading: string;
  subheading?: string;
  image?: string;
  imageAlt?: string;
}

const { heading, subheading, image, imageAlt } = Astro.props as Props;
---

<section class="hero">
  <div class="container">
    <div class="hero__copy">
      <h1 class="hero__heading">{heading}</h1>
      {subheading && <p class="hero__subheading">{subheading}</p>}
      <div class="hero__ctas">
        <slot />
      </div>
    </div>
    {image && <img class="hero__image" src={image} alt={imageAlt ?? ""} width="320" height="320" />}
  </div>
</section>
